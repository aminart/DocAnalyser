# Fichier facultatif. Les connexions aux modèles se règlent normalement dans l'application, onglet
# Réglages (plusieurs connexions, clés chiffrées, certificats). Les fournisseurs déclarés ici s'y ajoutent,
# en lecture seule : utile pour déployer la même configuration sur plusieurs postes.

# ============================================================================
# 1. FOURNISSEUR
# Endpoint compatible OpenAI (vLLM, Ollama, Azure OpenAI, Mistral, passerelle interne...)
# Les modèles listés dans CUSTOM_LLM_AVAILABLE_MODELS (séparés par des virgules)
# sont ceux proposés dans l'application, dans cet ordre.
# ============================================================================
CUSTOM_LLM_PROVIDER_NAME="Local / Custom Endpoint"
CUSTOM_LLM_API_KEY=""
CUSTOM_LLM_API_BASE=""
CUSTOM_LLM_CA_BUNDLE=""
CUSTOM_LLM_AVAILABLE_MODELS=""
# Fenêtre de contexte des modèles de ce fournisseur (tokens)
CUSTOM_LLM_CONTEXT_TOKENS=128000
# Longueur maximale de réponse (tokens) ; 0 = valeur par défaut du serveur
CUSTOM_LLM_MAX_OUTPUT_TOKENS=0

# ============================================================================
# 2. FOURNISSEUR COMPLEMENTAIRE (facultatif)
# ============================================================================
CUSTOM_LLM_2_PROVIDER_NAME="Fournisseur complémentaire"
CUSTOM_LLM_2_API_KEY=""
CUSTOM_LLM_2_API_BASE=""
CUSTOM_LLM_2_CA_BUNDLE=""
CUSTOM_LLM_2_AVAILABLE_MODELS=""
CUSTOM_LLM_2_CONTEXT_TOKENS=128000
CUSTOM_LLM_2_MAX_OUTPUT_TOKENS=0

# ============================================================================
# 3. CLÉS DE TEST (facultatif) — Google Gemini et Anthropic Claude
# Chaque fournisseur n'apparaît dans l'application que si sa clé est renseignée ;
# seuls les modèles listés dans *_TEST_MODELS sont proposés, dans cet ordre.
# ============================================================================
GEMINI_API_KEY=""
GEMINI_CA_BUNDLE=""
GEMINI_TEST_MODELS="gemini-3.8-flash,gemini-3.5-flash-lite"
GEMINI_CONTEXT_TOKENS=1000000

# ============================================================================
# 4. PARAMÈTRES GÉNÉRAUX (facultatif)
# ============================================================================
# Taille maximale d'une requête au modèle (tokens). 0 = jusqu'à la fenêtre du modèle.
# Avec une clé Gemini gratuite (volume limité par minute), indiquez par exemple 120000 :
# les gros documents sont alors analysés par lots au lieu d'être refusés.
MAX_REQUEST_TOKENS=0
# Appels simultanés au modèle en analyse par lots (réduire à 1 ou 2 sur une petite offre)
MAX_CONCURRENT_LLM_REQUESTS=4
# Taille maximale d'un fichier importé, en Mo
MAX_UPLOAD_MB=50
